<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="10" vgap="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.trycatchexample.StudentFormController">
    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <TextField fx:id="courseField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <Button fx:id="addButton" onAction="#handleAdd" text="Add Student" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <!--  Animated status message label -->
    <Label fx:id="statusLabel" text="" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <Label text="Course:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints /> <!-- Row 4 for the new status label -->
    </rowConstraints>
</GridPane>
